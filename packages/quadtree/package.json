{
  "name": "@sayari/trellis-quadtree",
  "version": "0.8.0-rc.1",
  "description": "Efficient pointerless region quadtree index for simulating large force-directed graphs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/d3-quadtree": "^3.0.6",
    "@types/tape": "^5.8.1",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "tap-spec": "^2.2.2",
    "tape": "^5.9.0",
    "tsx": "^4.22.4",
    "vite": "^6.3.5"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs src/index.ts",
    "clean": "rm -rf dist",
    "test": "tsx ./tests/index.ts | tap-spec",
    "perf": "tsx ./perf/index.ts",
    "perf:d3": "tsx ./perf/d3.ts",
    "perf:browser": "vite serve ./perf/",
    "viz": "vite serve ./viz/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayari-analytics/trellis.git",
    "directory": "packages/quadtree"
  },
  "keywords": [
    "trellis",
    "quadtree",
    "network",
    "simulation"
  ],
  "author": "James Conkling <james.lane.conkling@gmail.com> jameslaneconkling.github.io, Mikey Gower",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sayari-analytics/trellis/issues"
  },
  "homepage": "https://github.com/sayari-analytics/trellis#readme"
}
